<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Condition="$(AvaeFeatures.Contains(';CommunityToolkit;'))">
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\net11.0\Community\**\*.cs">
      <Visible>false</Visible>
    </Compile>
  </ItemGroup>

  <ItemGroup Condition="$(AvaeFeatures.Contains(';ReactiveUI;'))">
    <PackageReference Include="ReactiveUI" />
    <PackageReference Include="ReactiveUI.SourceGenerators">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <Compile Include="$(MSBuildThisFileDirectory)..\lib\net11.0\ReactiveUI\**\*.cs">
      <Visible>false</Visible>
    </Compile>
  </ItemGroup>
  
</Project>